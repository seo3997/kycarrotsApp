<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#e2e8f0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="접수"
                android:textColor="#64748b"
                android:background="#f1f5f9"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textSize="12sp"
                android:layout_marginRight="8dp" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="문의 제목"
                android:textColor="#1e293b"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="삭제"
                android:textColor="#ef4444"
                android:textSize="12sp"
                android:padding="4dp"
                android:visibility="gone" />
                
            <TextView
                android:id="@+id/tv_answer_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="답변 달기"
                android:textColor="?attr/colorPrimary"
                android:textSize="12sp"
                android:padding="4dp"
                android:layout_marginStart="8dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_qna_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="홍길동 | 2024.03.08"
            android:textColor="#94a3b8"
            android:textSize="12sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tv_contents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="문의 내용입니다."
            android:textColor="#64748b"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/ll_answer_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#f8fafc"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="답변"
                android:textColor="#6366f1"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_answer_contents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="답변 내용입니다."
                android:textColor="#475569"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_answer_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="공식 답변 | 2024.03.09"
                android:textColor="#94a3b8"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
